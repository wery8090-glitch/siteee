<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Chroma.Loader.App">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window"><Setter Property="Background" Value="#080C0A"/><Setter Property="Foreground" Value="#E8F0E5"/></Style>
    <Style Selector="TextBlock"><Setter Property="Foreground" Value="#E8F0E5"/></Style>
    <Style Selector="TextBox"><Setter Property="Background" Value="#141B17"/><Setter Property="Foreground" Value="#E8F0E5"/><Setter Property="BorderBrush" Value="#314238"/><Setter Property="Padding" Value="12,9"/><Setter Property="Margin" Value="0,6,0,0"/></Style>
    <Style Selector="Button"><Setter Property="Background" Value="#B6FF3B"/><Setter Property="Foreground" Value="#11180D"/><Setter Property="BorderBrush" Value="#B6FF3B"/><Setter Property="Margin" Value="0,10,0,0"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="16,10"/></Style>
    <Style Selector="Button:pointerover"><Setter Property="Background" Value="#D2FF78"/><Setter Property="BorderBrush" Value="#D2FF78"/></Style>
    <Style Selector="Button:pressed"><Setter Property="Background" Value="#91D91D"/></Style>
    <Style Selector="TextBox:focus"><Setter Property="BorderBrush" Value="#B6FF3B"/></Style>
    <Style Selector="CheckBox"><Setter Property="Foreground" Value="#A9B8AB"/></Style>
  </Application.Styles>
</Application>
